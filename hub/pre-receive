#!/usr/bin/env bash
# Git pre-receive hook for a repository nodes push to: through sat-ssh-gate (SAT_PUSH_PREFIX set),
# only refs under the project's PUSH_PREFIX may be written. Other pushes are not affected.
[ -n "$SAT_PUSH_PREFIX" ] || exit 0
while read -r _ _ ref; do
  case "$ref" in "$SAT_PUSH_PREFIX"*) ;; *) echo "nodes may push $SAT_PUSH_PREFIX* only, not $ref" >&2; exit 1 ;; esac
done
