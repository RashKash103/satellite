#!/usr/bin/env bash
# sat-agent PROJECT: the node's service (sat@PROJECT.service). Runs SLOTS lanes; each claims an item
# from the hub and runs the project's sat/job on it under a lease renewed every 2 min. Exit codes
# of the job: 0 passed (SAT_RESULT holds the words for `ok`), 1 failed (SAT_RESULT: reason line, then
# the summary), anything else: handed back for another lane. Keeps the project's bundle in step with
# the hub (every 5 min) and runs its sat/sync at start and hourly. `sat drain` stops new claims.
export SAT_PROJECT=$1
export SAT_BASE=$HOME/sat/$1 SAT_BUNDLE=$HOME/sat/$1/bundle
. "$SAT_BASE/config"
[ -f "$SAT_BASE/env" ] && . "$SAT_BASE/env"   # optional, node-local: e.g. PATH for the project's tools
export PATH="$HOME/sat/bin:$HOME/.local/bin:$PATH" SAT_NAME=${SAT_NAME:-$(hostname -s)}
ST=$SAT_BASE/state; mkdir -p "$ST"
log() { echo "$(date '+%m-%d %H:%M:%S') $*"; }
nap() { local i; for ((i=0; i<$1; i+=5)); do [ -e "$ST/drain" ] && return; sleep 5; done; }   # wakes for a drain

# Unpacked beside and swapped in whole, so a running job never reads a half-written file.
sync_bundle() {
  local t=$SAT_BASE/bundle.new; rm -rf "$t"; mkdir -p "$t"
  sat-call bundle | tar -C "$t" -xzf - || { rm -rf "$t"; return 1; }
  if [ -d "$SAT_BUNDLE" ] && diff -rq -x state "$t" "$SAT_BUNDLE" >/dev/null 2>&1; then rm -rf "$t"; return 0; fi
  [ -d "$SAT_BUNDLE/state" ] && cp -a "$SAT_BUNDLE/state" "$t/"
  [ -d "$SAT_BUNDLE" ] && mv "$SAT_BUNDLE" "$SAT_BASE/bundle.old"
  mv "$t" "$SAT_BUNDLE"; rm -rf "$SAT_BASE/bundle.old"; log "bundle updated from the hub"
}
sync_project() { [ -x "$SAT_BUNDLE/sat/sync" ] && "$SAT_BUNDLE/sat/sync"; }

lane() {
  local slot=$1 line id job rc t res=$ST/slot$1.result
  while [ ! -e "$ST/drain" ]; do
    line=$(sat-call claim "$SAT_NAME" "$slot") || { log "[$slot] hub unreachable"; nap 60; continue; }
    [ -z "$line" ] && { nap 45; continue; }
    id=${line%% *}; echo "$id" > "$ST/slot$slot.claim"; rm -f "$res"; log "[$slot] claimed $id"
    SAT_SLOT=$slot SAT_RESULT=$res setsid "$SAT_BUNDLE/sat/job" $line >> "$ST/slot$slot.log" 2>&1 & job=$!
    t=0
    while kill -0 $job 2>/dev/null; do
      sleep 5; t=$((t+5))
      [ $((t % 120)) -eq 0 ] || continue
      sat-call renew "$SAT_NAME" "$id"
      [ $? -eq 3 ] && { log "[$slot] lease on $id lost: stopping it"; kill -TERM -- -$job 2>/dev/null; }
    done
    wait $job; rc=$?
    case $rc in
      0) # shellcheck disable=SC2046  # the result is words for `ok`
         sat-call ok "$SAT_NAME" "$id" $(cat "$res" 2>/dev/null) && log "[$slot] $id passed" ;;
      1) tail -n +2 "$res" 2>/dev/null | sat-call fail "$SAT_NAME" "$id" "$(head -1 "$res" 2>/dev/null)"; log "[$slot] $id failed" ;;
      *) log "[$slot] $id: exit $rc, handing it back"; sat-call release "$SAT_NAME" "$id" ;;
    esac
    rm -f "$ST/slot$slot.claim"
  done
}

log "starting $SAT_PROJECT on $SAT_NAME: ${SLOTS:-1} lane(s), hub $HUB"
sync_bundle || { log "cannot reach the hub"; exit 1; }
. "$HOME/sat/bin/sat-lib"
[ -z "$(sat_plan "$SAT_BUNDLE")" ] || { log "this node is missing what $SAT_PROJECT needs (see: sat $SAT_PROJECT check); not starting"; exit 0; }
sync_project
for s in $(seq 1 "${SLOTS:-1}"); do lane "$s" & done
n=0
while [ -n "$(jobs -r)" ]; do
  sleep 10; n=$((n+1))
  [ $((n % 30)) -eq 0 ] && sync_bundle      # every 5 min
  [ $((n % 360)) -eq 0 ] && sync_project    # hourly
done
rm -f "$ST/drain"; log "drained: stopping"
